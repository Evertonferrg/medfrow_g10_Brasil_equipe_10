# Modelo: o mediflow-sync.sh troca __TAG__ pelo SHA do commit da main e grava em
# ~/.config/containers/systemd/mediflow.container. Gera o mediflow.service.

[Unit]
Description=MediFlow (app)

[Container]
# Nome que o Caddy usa. Não pode ser "mediflow": é o hostname da VM, e o /etc/hosts copiado do host
# faria o nome apontar para a própria VM em vez do container.
ContainerName=mediflow-app
Image=iad.ocir.io/idzac8al3ypr/mediflow:__TAG__
Network=mediflow.network
# Sem PublishPort: a app escuta na 8000 só dentro da rede mediflow. Quem expõe é o Caddy.

# Fallback em disco do app/storage.py: fora do container, para sobreviver a cada deploy.
# :U ajusta o dono do volume para o usuário da imagem (Wolfi costuma rodar como nonroot).
Environment=STORAGE_LOCAL_DIR=/dados
Environment=EVENTOS_DIR=/dados/eventos
Environment=OCI_NAMESPACE=idzac8al3ypr
Environment=OCI_AUTH=instance_principal
Volume=mediflow-dados.volume:/dados:U

# Chave do Gemini (extração automática). O secret precisa existir na VM ANTES deste arquivo chegar,
# senão o container não sobe:  podman secret create gemini_api_key -
Environment=GEMINI_MODEL=gemini-2.5-flash
Secret=gemini_api_key,type=env,target=GEMINI_API_KEY

# Notificações (Slack e Gmail)
Environment=NOTIFICACAO_AUTOMATICA=true
Environment=NOTIFICACAO_CANAL=ambos
Environment=UI_BASE_URL=https://mediflow-oci.duckdns.org
Environment=SLACK_CHANNEL_ID=C0CGVRHQVT9

# Responsáveis do MediFlow. Valores com espaço ou ";" vão com a atribuição inteira entre aspas
# (sintaxe do systemd); as aspas não entram no valor.
# PLANTÃO MÉDICO
Environment="PLANTAO_NOME=Frederico Macau"
Environment="PLANTAO_TRATAMENTO=Dr(a)."
Environment="PLANTAO_FUNCAO=Médico Plantonista"
Environment=PLANTAO_EMAIL=fredericomacau314@gmail.com
Environment="PLANTAO_EMAILS=guedesfeverton@gmail.com;fredericomacau314@gmail.com;insights.do.cesar@gmail.com;grufinosouza@gmail.com"
Environment="PLANTAO_SLACK_ID=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"
Environment="PLANTAO_SLACK_IDS=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"

# AUDITORIA
Environment="AUDITORIA_NOME=César Augusto de Fázio"
Environment="AUDITORIA_TRATAMENTO=Sr(a)."
Environment="AUDITORIA_FUNCAO=Auditoria Médica"
Environment=AUDITORIA_EMAIL=insights.do.cesar@gmail.com
Environment="AUDITORIA_EMAILS=guedesfeverton@gmail.com;fredericomacau314@gmail.com;insights.do.cesar@gmail.com;grufinosouza@gmail.com"
Environment="AUDITORIA_SLACK_ID=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"
Environment="AUDITORIA_SLACK_IDS=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"

# FARMÁCIA
Environment="FARMACIA_NOME=Gabriel Souza"
Environment="FARMACIA_TRATAMENTO=Sr(a)."
Environment="FARMACIA_FUNCAO=Farmácia Hospitalar"
Environment=FARMACIA_EMAIL=grufinosouza@gmail.com
Environment="FARMACIA_EMAILS=guedesfeverton@gmail.com;fredericomacau314@gmail.com;insights.do.cesar@gmail.com;grufinosouza@gmail.com"
Environment="FARMACIA_SLACK_ID=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"
Environment="FARMACIA_SLACK_IDS=U0CH9989XT8;U0CJHLB3600;U0CHNLP7CD8;U0CHLK0M894"

# Credenciais de notificação. Os valores ficam no OCI Vault e são copiados à mão para
# Podman secrets na VM. Precisam existir ANTES deste arquivo chegar, senão o container não sobe.
Secret=mediflow-slack-webhook-url,type=env,target=SLACK_WEBHOOK_URL
Secret=mediflow-slack-bot-token,type=env,target=SLACK_BOT_TOKEN
Secret=mediflow-gmail-app-password,type=env,target=GMAIL_APP_PASSWORD
Secret=mediflow-gmail-user,type=env,target=GMAIL_USER
Secret=mediflow-plantao-email-destino,type=env,target=PLANTAO_EMAIL_DESTINO

# Healthcheck explícito (a imagem não tem curl/wget; o python3 tem). Travou 3 vezes seguidas:
# o Podman mata o container e o Restart=always do systemd sobe de novo.
HealthCmd=python3 -c "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=3)"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
