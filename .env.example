# ==============================================================================
# MediFlow — Variáveis de Ambiente (.env)
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ==============================================================================

# 1. Google Gemini (Extração inteligente via LLM)
GEMINI_API_KEY=sua_chave_do_google_ai_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Configurações da API Backend (FastAPI)
API_URL=http://localhost:8000
LIMIAR_CONFIANCA=0.80

# 3. Armazenamento de Documentos e Triagens
# Por padrão, se OCI não for configurada, salva localmente em storage_local/
STORAGE_LOCAL_DIR=storage_local
OCI_BUCKET=mediflow-documentos-clinicos

# (Opcional) Integração com Oracle Cloud Infrastructure (OCI) real:
# OCI_NAMESPACE=seu_namespace_oci
# OCI_CONFIG_FILE=~/.oci/config
# OCI_AUTH=instance_principal
# ==============================================================================
# 4. Notificacoes Gmail e Slack
# ==============================================================================
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_aplicativo
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/EXEMPLO

# ==============================================================================
# 5. Responsaveis por setor
# ==============================================================================

# Plantao
PLANTAO_NOME=Nome do responsavel
PLANTAO_TRATAMENTO=Dr(a).
PLANTAO_FUNCAO=Medico Plantonista
PLANTAO_EMAIL=email@exemplo.com
PLANTAO_SLACK_ID=U0000000000

# Auditoria
AUDITORIA_NOME=Nome do responsavel
AUDITORIA_TRATAMENTO=Sr(a).
AUDITORIA_FUNCAO=Auditoria Medica
AUDITORIA_EMAIL=email@exemplo.com
AUDITORIA_SLACK_ID=U0000000000

# Farmacia
FARMACIA_NOME=Nome do responsavel
FARMACIA_TRATAMENTO=Sr(a).
FARMACIA_FUNCAO=Farmacia Hospitalar
FARMACIA_EMAIL=email@exemplo.com
FARMACIA_SLACK_ID=U0000000000

# ==============================================================================
# 6. Controle das notificacoes automaticas
# ==============================================================================
NOTIFICACAO_AUTOMATICA=false
NOTIFICACAO_CANAL=ambos
